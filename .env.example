# Control Plane
CONTEXT_ANCHOR_HOST=127.0.0.1
CONTEXT_ANCHOR_PORT=8000
CONTEXT_ANCHOR_DB_PATH=runtime/context_anchor.db
CONTEXT_ANCHOR_USER_TOKEN=troque-por-um-token-longo-e-aleatorio
CONTEXT_ANCHOR_AGENT_TOKEN=troque-por-outro-token-longo-e-aleatorio
CONTEXT_ANCHOR_TASK_LEASE_SECONDS=120
CONTEXT_ANCHOR_TASK_MAX_ATTEMPTS=3

# Local Agent
CONTEXT_ANCHOR_CONTROL_PLANE_URL=http://127.0.0.1:8000
CONTEXT_ANCHOR_AGENT_ID=desktop-principal
CONTEXT_ANCHOR_POLL_INTERVAL_SECONDS=2
CONTEXT_ANCHOR_BROWSER_HEADLESS=false

# Desktop control — desativado por padrão até validação local
CONTEXT_ANCHOR_DESKTOP_ENABLED=false
CONTEXT_ANCHOR_SCREENSHOT_DIR=runtime/screenshots

# Emergency stop local
CONTEXT_ANCHOR_EMERGENCY_STOP_PATH=runtime/EMERGENCY_STOP
CONTEXT_ANCHOR_AGENT_PID_PATH=runtime/local_agent.pid
