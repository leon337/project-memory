# Painel do Robô — interface local de operação e aprendizado
CONTEXT_ANCHOR_DASHBOARD_HOST=127.0.0.1
CONTEXT_ANCHOR_DASHBOARD_PORT=8765
CONTEXT_ANCHOR_CENTRAL_PID_PATH=runtime/central.pid
CONTEXT_ANCHOR_LOG_DIR=runtime/logs

# Central
CONTEXT_ANCHOR_HOST=127.0.0.1
CONTEXT_ANCHOR_PORT=8000
CONTEXT_ANCHOR_DB_PATH=runtime/context_anchor.db
CONTEXT_ANCHOR_USER_TOKEN=troque-por-um-token-longo-e-aleatorio
CONTEXT_ANCHOR_AGENT_TOKEN=troque-por-outro-token-longo-e-aleatorio
CONTEXT_ANCHOR_TASK_LEASE_SECONDS=120
CONTEXT_ANCHOR_TASK_MAX_ATTEMPTS=3

# Robô local
CONTEXT_ANCHOR_CONTROL_PLANE_URL=http://127.0.0.1:8000
CONTEXT_ANCHOR_AGENT_ID=desktop-principal
CONTEXT_ANCHOR_POLL_INTERVAL_SECONDS=2
CONTEXT_ANCHOR_BROWSER_HEADLESS=false

# Planner — mantenha deterministic até configurar ao menos uma API localmente
CONTEXT_ANCHOR_PLANNER_MODE=deterministic
CONTEXT_ANCHOR_PLANNER_TIMEOUT_SECONDS=25
CONTEXT_ANCHOR_PLANNER_COOLDOWN_SECONDS=30

# Z.AI / GLM — segredo somente no .env local
CONTEXT_ANCHOR_ZAI_API_KEY=
CONTEXT_ANCHOR_ZAI_MODEL=glm-4.7-flash

# Cloudflare Workers AI — token e Account ID locais
CONTEXT_ANCHOR_CLOUDFLARE_API_TOKEN=
CONTEXT_ANCHOR_CLOUDFLARE_ACCOUNT_ID=
CONTEXT_ANCHOR_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CONTEXT_ANCHOR_CLOUDFLARE_RPM_LIMIT=300

# Google Gemini — segredo somente no .env local
CONTEXT_ANCHOR_GEMINI_API_KEY=
CONTEXT_ANCHOR_GEMINI_MODEL=gemini-3.5-flash
CONTEXT_ANCHOR_GEMINI_RPM_LIMIT=20

# Controle do desktop — desativado por padrão até validação local
CONTEXT_ANCHOR_DESKTOP_ENABLED=false
CONTEXT_ANCHOR_SCREENSHOT_DIR=runtime/screenshots

# Parada de emergência local
CONTEXT_ANCHOR_EMERGENCY_STOP_PATH=runtime/EMERGENCY_STOP
CONTEXT_ANCHOR_AGENT_PID_PATH=runtime/local_agent.pid
